# Variáveis usadas pela função netlify/functions/pedido-email.mts.
# Em produção elas ficam em Netlify → Project configuration → Environment variables.
# NUNCA comitar o arquivo .env de verdade — o .gitignore já bloqueia.

# Chave da conta do Resend (provedor de envio). Obrigatória para o aviso sair.
RESEND_API_KEY=""

# Para onde vai o aviso de pedido novo.
EMAIL_DESTINO="avesornamentaisbrasil@gmail.com"

# Remetente. O padrão do provedor só entrega no e-mail dono da conta.
# Para escrever ao CLIENTE é obrigatório um endereço de domínio verificado:
# EMAIL_REMETENTE="Aves Arca <contato@avesarca.com.br>"
EMAIL_REMETENTE=""

# "1" liga a confirmação por e-mail para o cliente. Só ligar depois de verificar o domínio.
CONFIRMA_CLIENTE=""

# Marca deste build (aob | stima | alianca). Sem valor = aob. Ver src/marcas.ts.
VITE_MARCA=aob
# Website id do Umami desta marca (ids em src/marcas.ts). Sem valor = id do AOB.
VITE_UMAMI_ID=60547214-1e23-4b1b-894a-9b2ab0807191
